# Use official python slim image
FROM python:3.10-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    build-essential \
    git \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /workspace

# Copy dependencies first for caching
COPY requirements.txt requirements-web.txt pyproject.toml ./

# Install python dependencies
RUN pip3 install --upgrade pip
RUN pip3 install -r requirements-web.txt

# Copy the rest of the application
COPY src/ ./src
COPY main.py config.json ./

# Install package in editable/local mode
RUN pip3 install -e .

# Expose FastAPI port
EXPOSE 8000

# Set environment variables
ENV PYTHONUNBUFFERED=1

# Command to run the FastAPI app
CMD ["uvicorn", "src.web.server:app", "--host", "0.0.0.0", "--port", "8000"]
