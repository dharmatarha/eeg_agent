# Use NVIDIA CUDA base for GPU acceleration
FROM nvidia/cuda:12.1.1-devel-ubuntu22.04
# Install System Dependencies
RUN apt-get update && apt-get install -y \
    python3-pip python3-dev git wget unzip \
    libgl1-mesa-glx libqt5gui5 \
    && rm -rf /var/lib/apt/lists/*

# Install Python Neuroimaging Stack
RUN pip3 install --upgrade pip
RUN pip3 install \
    mne mne-bids mne-connectivity mne-bids-pipeline \
    scikit-learn pandas matplotlib jupyter_client \
    jupyter_kernel_gateway ipykernel

# Register the Python 3 kernel spec
RUN python3 -m ipykernel install --sys-prefix

# Expose Jupyter Kernel Gateway port
EXPOSE 8888

# Work directory for execution
WORKDIR /workspace

# Set memory limit configuration for MNE
ENV MNE_MEMMAP_MIN_SIZE=10M

# Run Jupyter Kernel Gateway on start
CMD ["jupyter", "kernelgateway", "--KernelGatewayApp.ip=0.0.0.0", "--KernelGatewayApp.port=8888"]
